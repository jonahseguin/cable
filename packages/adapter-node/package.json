{
  "name": "@cable/adapter-node",
  "version": "0.0.0",
  "private": true,
  "description": "Node development host and WebSocket adapter.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
