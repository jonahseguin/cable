{
  "name": "@cablejs/adapter-node",
  "version": "0.1.0",
  "private": false,
  "description": "Node development host and WebSocket adapter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonahseguin/cable.git",
    "directory": "packages/adapter-node"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cablejs/contract": "workspace:*",
    "@cablejs/core": "workspace:*",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@cablejs/conformance": "workspace:*",
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1",
    "zod": "4.5.4"
  }
}
