{
  "name": "@cable/client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed procedure proxy, HTTP links, and per-host resumable sockets.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cable/contract": "workspace:*",
    "@cable/core": "workspace:*"
  },
  "devDependencies": {
    "@cable/adapter-memory": "workspace:*",
    "zod": "4.5.4"
  }
}
