      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cablejs/contract": "workspace:*",
    "@cablejs/core": "workspace:*"
  },
  "devDependencies": {
    "@cablejs/adapter-memory": "workspace:*",
    "zod": "4.5.4"
  }
}
