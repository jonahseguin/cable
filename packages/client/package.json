{
  "name": "@cablejs/client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed procedure proxy, HTTP links, and per-host resumable sockets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonahseguin/cable.git",
    "directory": "packages/client"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
