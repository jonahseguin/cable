{
  "name": "@cablejs/cloudflare",
  "version": "0.1.0",
  "private": false,
  "description": "Durable Objects host, authenticated edge handler, and workerd conformance.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonahseguin/cable.git",
    "directory": "packages/cloudflare"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "test": "vitest run src --config vitest.unit.config.ts",
    "test:workerd": "vitest run --config vitest.config.ts --max-workers=1 --no-isolate",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.workerd.json && tsc --noEmit -p workerd/tsconfig.json",
    "types:check": "wrangler types --config wrangler.test.jsonc --env-interface CloudflareTestEnv worker-configuration.d.ts --check",
    "types:generate": "wrangler types --config wrangler.test.jsonc --env-interface CloudflareTestEnv worker-configuration.d.ts"
  },
  "dependencies": {
    "@cablejs/contract": "workspace:*",
    "@cablejs/core": "workspace:*"
  },
  "devDependencies": {
    "@cablejs/conformance": "workspace:*",
    "@cloudflare/vitest-plugin": "1.1.4",
    "vitest": "4.1.11",
    "wrangler": "4.129.0",
    "zod": "4.5.4"
  }
}
