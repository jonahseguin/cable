DESCRIPTION >
    Provides a time series of connection counts (established and closed) for a given organization,
    with flexible date range and granularity options. This pipe is designed to power dashboard
    visualizations showing connection trend analysis.

NODE filter_connections
SQL >
    %
    SELECT
        timestamp,
        event_type,
        organization_id
    FROM events
    WHERE organization_id = {{ String(organization_id, description="Organization ID to filter events for", required=True) }}
      AND event_type IN ('connection_established', 'connection_closed')
      {% if defined(start_date) %}
      AND timestamp >= {{ DateTime64(start_date, description="Start timestamp for analysis (inclusive)", required=False) }}
      {% end %}
      {% if defined(end_date) %}
      AND timestamp < {{ DateTime64(end_date, description="End timestamp for analysis (exclusive)", required=False) }}
      {% end %}

NODE aggregate_by_interval
SQL >
    %
    -- Use templating to select the correct time bucketing function based on granularity
    -- Check the parameter value directly within the template logic
    SELECT
        {% if String(granularity, 'hour', description="Time granularity for aggregation", required=False, enum=['minute', 'hour', 'day', 'week', 'month']) == 'minute' %}
            toStartOfMinute(timestamp)
        {% elif String(granularity, 'hour') == 'hour' %}
            toStartOfHour(timestamp)
        {% elif String(granularity, 'hour') == 'day' %}
            toStartOfDay(timestamp)
        {% elif String(granularity, 'hour') == 'week' %}
            toStartOfWeek(timestamp, 1) -- Mode 1: week starts on Monday
        {% elif String(granularity, 'hour') == 'month' %}
            toStartOfMonth(timestamp)
        {% else %}
            toStartOfHour(timestamp) -- Default fallback if parameter is missing or invalid (redundant due to default in String())
        {% end %}
        AS time_interval,
        countIf(event_type = 'connection_established') AS connections_opened,
        countIf(event_type = 'connection_closed') AS connections_closed,
        connections_opened - connections_closed AS net_connections
    FROM filter_connections
    GROUP BY time_interval
    ORDER BY time_interval ASC

TYPE endpoint
