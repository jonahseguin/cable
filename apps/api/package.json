{
  "name": "api",
  "version": "0.0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail --format pretty | grep -v ' - Ok @ '",
    "deploy:production": "wrangler deploy --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "build": "wrangler build",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "test": "./test.sh",
    "typegen": "wrangler types"
  },
  "devDependencies": {
    "typescript": "^5.5.2",
    "wrangler": "^4.7.0"
  },
  "dependencies": {
    "@hapi/iron": "^7.0.1",
    "@hono/zod-validator": "^0.4.3",
    "@sock8/auth": "workspace:*",
    "@sock8/db": "workspace:*",
    "@sock8/sdk": "workspace:*",
    "drizzle-orm": "0.41.0",
    "hono": "^4.7.5",
    "mysql2": "^3.14.0",
    "zod": "^3.24.2"
  }
}
