{
  "name": "@sock8/sdk",
  "module": "index.ts",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts src/client/index.ts src/server/index.ts src/server/internal.ts src/common/index.ts --dts --format esm --out-dir dist --tsconfig tsconfig.json && tsc-alias -p tsconfig.json",
    "test": "vitest run --coverage --config vitest.config.ts"
  },
  "exports": {
    "./server": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    },
    "./__internal": {
      "import": "./dist/server/internal.js",
      "types": "./dist/server/internal.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    },
    "./dsl": {
      "import": "./dist/common/index.js",
      "types": "./dist/common/index.d.ts"
    }
  },
  "dependencies": {
    "@hapi/iron": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "superjson": "^2.2.2"
  },
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.9",
    "@vitest/coverage-v8": "^3.1.2",
    "tsc-alias": "^1.8.15",
    "tsup": "^8.4.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.2"
  },
  "peerDependencies": {
    "typescript": "^5",
    "zod": "^3.24.2"
  }
}
